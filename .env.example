# Copy to .env for local dev, and set the same vars in the Vercel project.
# Every feature degrades gracefully when its vars are absent (HTTP 503 not_configured),
# so the site stays deployable even with none of these set.

# --- AI Mentor (Anthropic) ---
# Get a key at https://console.anthropic.com. IMPORTANT: set a $0.50 workspace
# spend limit in Console -> Limits as the hard cost backstop.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-haiku-4-5, the cheapest capable model).
ANTHROPIC_MODEL=claude-haiku-4-5
# Demo cost guards (defaults shown). Global cap ~150 generations stays well under $0.50.
MENTOR_GLOBAL_LIMIT=150
MENTOR_IP_LIMIT=5
MENTOR_IP_WINDOW_SEC=86400

# --- Chapter applications (Neon Postgres) ---
# Free serverless Postgres at https://neon.tech. Also backs the mentor rate-limit counters.
DATABASE_URL=

# --- Email (Resend) ---
# Rotate the key after first use. Free tier sends from onboarding@resend.dev to your own
# verified address; set RESEND_FROM to a verified domain to email applicants too.
RESEND_API_KEY=
RESEND_FROM=Vira Hacks <onboarding@resend.dev>
FOUNDER_EMAIL=rikhinkavuru@gmail.com

# --- GitHub network heartbeat (optional) ---
# Works unauthenticated (60 req/hr). A fine-grained read-only PAT raises it to 5000/hr.
GITHUB_REPO=rikhinkavuru/virawebsite
GITHUB_TOKEN=

# --- Client feature flags (Vite) ---
# Turn on live /api fetching for the map/stats once verified on a preview URL.
VITE_FEATURE_LIVE_NETWORK=false
VITE_FEATURE_MENTOR=true
VITE_FEATURE_APPLY=true
